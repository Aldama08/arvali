---
---

<section id="Servicios" class="main-container">
        
        <h2 class="titulo" >Servicios</h2>

        <div class="icon-row">

            <div class="icon">
                <img src="shield.svg" alt="shield">
                <span>Seguridad</span>
            </div>

            <div class="icon">
                <img src="settings-heart.svg" alt="settings">
                <span>Mantenimiento</span>
            </div>

            <div class="icon">
                <img src="network.svg" alt="network">
                <span>Red</span>
            </div>

        </div>

        
</section>

<style>
    .main-container{
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 5rem;
        gap: 2rem;
        margin: 1rem;
    }

    
    .icon-row{
        display: flex;
        flex-direction: row;
        justify-content: center;
        padding: 1rem;
        gap: 20rem;
    }
    
    .icon{
        width: 80px;
        height: 80px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem;
        gap: 1rem;
        border: 3px solid #006699;
        border-radius: 10px;
    }
    
    img{
        width: 50px;
        height: auto;
    }
    
    .titulo{
        margin: 0;
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        font-size: 1.5rem;
        text-align: left;
    }

    span{
        font-family: sans-serif;
        font-weight: bold;
        color: #333;
        text-align: center;
    }
    

    

</style>