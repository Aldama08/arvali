---
const whatsapp = import.meta.env.WHATSAPP;
---


<section class="main-Container">

    <hgroup class="text">
    <h1>Mejorando tu infraestructura</h1>
    <h2>Dar mejores soluciones</h2>
    </hgroup>

    <div class="info-container">
        <a class="info-buttom" href="#Servicios">
            <h4>Información</h4>
        </a>
        <a target="_blank" class="whatsapp-buttom" href={whatsapp}>
            <img  class="whatsapp-img" src="/whatsapp-completo.svg" alt="Whatsapp">
        </a>
    </div>
</section>



<style>
    .main-Container{
        margin: 0;
        display: flex;
        flex-direction: column;
        max-width: 100%;
        min-height: 60hv;
        /* border: 1px solid #111; */
        align-items: center;
        text-align: center;
        justify-content: center;
        position: relative;
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;
        gap: 2rem;
    }

    .text{
        padding: 15px;
    }
    .text h1{
        margin: 1rem;
        font-size: 3rem;
    }
    .text h2{
        margin: 10px ;
        font-size: 2rem;
        font-weight: normal;
    }

    .info-container{
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 50px;
        padding: 1rem;
        width: 100%;
    }

    .info-buttom{
        text-decoration: none;
        color: black;
    }
    .info-buttom h4{
        margin: 0;
    }

    .whatsapp-img{
        display: block;
        max-width: 120px;
        height: auto;
    }


</style>